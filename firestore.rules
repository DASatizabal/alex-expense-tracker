rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Push subscriptions: primary user and admin can read/write
    match /push_subscriptions/{subId} {
      allow read, write: if request.auth != null
        && (request.auth.token.email == 'lalexcubilla@gmail.com'
            || request.auth.token.email == 'dasatizabal@gmail.com');
    }

    // Expense config: primary user and admin can write
    match /expense_config/{docId} {
      allow read, write: if request.auth != null
        && (request.auth.token.email == 'lalexcubilla@gmail.com'
            || request.auth.token.email == 'dasatizabal@gmail.com');
    }
  }
}
